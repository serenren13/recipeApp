import { AppBar, Toolbar, Box, Button, Typography } from '@mui/material';
import { NavLink, useNavigate } from 'react-router-dom';
import { signOut } from 'firebase/auth';
import { auth } from '../firebase';

const NAV_LINKS = [
  { label: 'Home', to: '/' },
  { label: 'Recipes', to: '/recipes' },
  { label: 'My Recipes', to: '/my-recipes' },
  { label: 'Create Recipes', to: '/create-recipe' },
];

export default function Navbar() {
  const navigate = useNavigate();

  const handleLogout = async () => {
    await signOut(auth);
    navigate('/');
  };

  return (
    <AppBar position="static" elevation={0} sx={{ bgcolor: '#077a7d' }}>
      <Toolbar>
        {/* Logo */}
        <Box sx={{ display: 'flex', alignItems: 'center' }}>
          <Typography
            variant="h6"
            sx={{
              fontWeight: 700,
              color: '#fff',
              letterSpacing: 1,
            }}
          >
            🍴 Food Connect
          </Typography>
        </Box>

        {/* Push everything else to the right */}
        <Box sx={{ flexGrow: 1 }} />

        {/* Nav links */}
        <Box sx={{ display: 'flex', gap: 0.5 }}>
          {NAV_LINKS.map(({ label, to }) => (
            <Button
              key={to}
              component={NavLink}
              to={to}
              sx={{
                color: '#fff',
                textTransform: 'none',
                fontWeight: 400,
                borderRadius: 2,
                px: 1.5,
                '&.active': {
                  bgcolor: 'rgba(0,0,0,0.25)',
                  fontWeight: 600,
                },
                '&:hover': {
                  bgcolor: 'rgba(0,0,0,0.15)',
                },
              }}
            >
              {label}
            </Button>
          ))}
        </Box>

        {/* Admin button */}
        <Button
          component={NavLink}
          to="/admin"
          sx={{
            ml: 1,
            color: '#fff',
            textTransform: 'none',
            fontWeight: 600,
            borderRadius: 2,
            bgcolor: 'rgba(255,255,255,0.15)',
            '&.active': {
              bgcolor: 'rgba(255,255,255,0.25)',
            },
            '&:hover': {
              bgcolor: 'rgba(255,255,255,0.25)',
            },
          }}
        >
          Admin
        </Button>

        {/* Log Out */}
        <Button
          onClick={handleLogout}
          variant="contained"
          sx={{
            ml: 1,
            bgcolor: '#111',
            color: '#fff',
            textTransform: 'none',
            fontWeight: 600,
            borderRadius: 2,
            '&:hover': { bgcolor: '#333' },
          }}
        >
          Log Out
        </Button>
      </Toolbar>
    </AppBar>
  );
}